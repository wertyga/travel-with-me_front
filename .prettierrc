{
  "semi": true,
  "tabWidth": 2,
  "singleQuote": true,
  "trailingComma": "es5",
  "arrowParens": "avoid",
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "importOrder": [
    "^react$",
    "^react-native$",
    "^@react-navigation",
    "^react(.*)$",
    "^@expo(.*)$",
    "expo(.*)$",
    "mobx(.*)$",
    "<THIRD_PARTY_MODULES>",
    "^@/.(?:assets|types|utils)",
    "@/utils",
    "@/types",
    "@/styles",
    "^@/assets",
    "^[./]"
  ],
  "plugins": ["@trivago/prettier-plugin-sort-imports"]
}
